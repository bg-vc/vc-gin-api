VC_HTTP_ADDRESS=:8080
VC_GIN_MODE=debug

# Local development values only. Replace them outside your own machine.
VC_JWT_SECRET=replace-this-local-secret-with-at-least-32-characters
VC_JWT_EXPIRY=30m

VC_DB_HOST=127.0.0.1
VC_DB_PORT=3306
VC_DB_NAME=demo
VC_DB_USER=vcgin
VC_DB_PASSWORD=vc-gin-api-local
VC_DB_ROOT_PASSWORD=vc-gin-api-root-local

# Redis is an optional example. The API works when it is disabled.
VC_REDIS_ENABLED=false
VC_REDIS_ADDRESS=127.0.0.1:6379
VC_REDIS_PORT=6379
VC_REDIS_PASSWORD=
VC_REDIS_DB=0
